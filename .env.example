# =============================================
# 🔐 TikTok Affiliate Video Creator - API Keys
# =============================================
# คัดลอกไฟล์นี้และเปลี่ยนชื่อเป็น .env.local
# แล้วใส่ API Keys ที่ได้จากการสมัครบริการต่างๆ

# ---------------------------------------------
# 🤖 Google Gemini AI (สำหรับสร้าง Script และ SEO)
# สมัครได้ที่: https://aistudio.google.com/apikey
# ---------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---------------------------------------------
# 🎬 Google VEO3 API (สำหรับสร้างวิดีโอ)
# สมัครได้ที่: https://aistudio.google.com/apikey
# หมายเหตุ: ใช้ API Key เดียวกับ Gemini ได้
# ---------------------------------------------
VEO3_API_KEY=your_veo3_api_key_here

# ---------------------------------------------
# 🖼️ Google Imagen API (สำหรับสร้างรูปภาพ)
# สมัครได้ที่: https://aistudio.google.com/apikey
# หมายเหตุ: ใช้ API Key เดียวกับ Gemini ได้
# ---------------------------------------------
IMAGEN_API_KEY=your_imagen_api_key_here

# ---------------------------------------------
# 🗄️ Database (Supabase หรือ PostgreSQL)
# สมัคร Supabase ได้ที่: https://supabase.com
# หรือใช้ PostgreSQL ในเครื่อง
# ---------------------------------------------
DATABASE_URL="postgresql://username:password@localhost:5432/tiktok_creator?schema=public"

# ---------------------------------------------
# 🌐 Application Settings
# ---------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------
# 📁 File Storage (Optional - สำหรับเก็บไฟล์วิดีโอ)
# สมัครได้ที่: https://supabase.com (Storage)
# หรือ https://cloudinary.com
# ---------------------------------------------
# SUPABASE_URL=your_supabase_url
# SUPABASE_ANON_KEY=your_supabase_anon_key
